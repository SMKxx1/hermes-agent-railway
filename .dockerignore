**/*.sqlite3

# IDE / agent tooling (worktrees under .claude/ can contain source checkouts)
.vscode/
.idea/
.claude/
*.swp
*.swo

# Testing
.pytest_cache/
.coverage
htmlcov/

# Documentation
*.md

# Runtime data (bind-mounted at /opt/data; must not leak into build context)
data/
.hermes-docker/
.notebooklm-home/
sessions/
**/sessions/
mcp-tokens/
**/mcp-tokens/
whatsapp/session/
**/whatsapp/session/
platforms/whatsapp/session/
**/platforms/whatsapp/session/

# Compose/profile runtime state (bind-mounted; avoid ownership/secret issues)
hermes-config/
runtime/
railway.json
railway.toml
.railway/
local-migration*
*.tar
*.tar.gz
*.zip

# ---------- Not needed inside the Docker image ----------

# Desktop app source (Tauri/Electron); never installed in the container.
# apps/shared is the dashboard↔desktop websocket helper and is linked from
# web/package.json as a file: workspace dep — keep it in the build context.
apps/
!apps/shared/
!apps/shared/**

# Test suite — not shipped in production images
tests/

# Documentation site (Docusaurus) and supplementary docs
website/
docs/

# Assets only used by the GitHub README
assets/
infographic/

# Plugin-level docs (hermes-achievements ships docs/ but the runtime doesn't read them)
plugins/hermes-achievements/docs/

# Nix / Homebrew / AUR packaging metadata — irrelevant to Docker
nix/
flake.nix
flake.lock
packaging/

# Design and planning documents
plans/
.plans/

# Repo-level dotfiles that are git-only or dev-tooling config
.env.example
.envrc
.gitattributes
.hadolint.yaml
.mailmap

# Public Railway derivative: local tooling and unrelated metadata
.hermes/
.codex/
.agents/
contributors/
mcp-research-data/
sqlite_leak_fix.png
log.txt
Dockerfile.upstream
*.bak*
*.log
