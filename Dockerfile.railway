# syntax=docker/dockerfile:1.7
# Railway distribution image on the upstream image built from the upstream commit this branch
# last merged (its org.opencontainers.image.revision label). Keep its pinned toolchain and s6
# supervision, but rebuild dependencies and frontends from this checkout's locks so temporary
# security fixes also reach the installed runtime, not only the copied manifests.
# upstream-sync.yml moves the digest and the merged upstream commit together.
ARG HERMES_BASE=nousresearch/hermes-agent@sha256:45666f35ffa4102e1233ad6df41ccb548a0e4425063f89901117e7e84f74e54a
FROM ${HERMES_BASE} AS railway-base
USER root
WORKDIR /opt/hermes

# Refresh security fixes for packages inherited from the pinned Debian base.
# Bump this date when reviewing a new batch of distro advisories so the layer
# is invalidated even when the upstream image digest is unchanged.
ARG DEBIAN_SECURITY_REFRESH=2026-09-29
RUN test -n "$DEBIAN_SECURITY_REFRESH" && apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# PM builds a fresh sealed environment with the same extras as upstream's production image.
# Cache this stage independently of source edits; never mutate the inherited managed venv.
FROM railway-base AS railway-python
COPY pyproject.toml uv.lock ./
RUN rm -rf /opt/hermes/.venv \
    && HERMES_HOME=/tmp/railway-python-build python3 -m pm.build_env \
        --source /opt/hermes --python /usr/local/bin/python3 \
        --out /opt/hermes/.venv --no-install-project --sealed \
        --extra all --extra messaging --extra otlp --extra anthropic --extra bedrock \
        --extra azure-identity --extra matrix --extra google-chat

# Build tools stay in this stage. The final image receives only compiled products and tsc.
FROM railway-base AS railway-frontend
COPY --link --chmod=a+rX,go-w . /opt/hermes/
ENV npm_config_install_links=false
RUN node scripts/build/node-deps.mjs --source /opt/hermes --workspace ui-tui --workspace web \
    && /opt/hermes/.venv/bin/python -I scripts/generate_icons.py --source /opt/hermes --out /tmp/hermes-icons \
    && node scripts/build/tui.mjs --source /opt/hermes --out /opt/products/tui \
    && node scripts/build/web.mjs --source /opt/hermes --icons /tmp/hermes-icons --out /opt/products/web

FROM railway-base AS runtime
ARG RAILWAY_GIT_COMMIT_SHA
ARG HERMES_CUSTOM_REVISION=${RAILWAY_GIT_COMMIT_SHA:-unversioned-source-build}
ARG HERMES_SOURCE_URL

# Remove inherited products before copying replacements so old dependency metadata and
# content-hashed assets cannot survive a lock update.
RUN rm -rf /opt/hermes/.venv /opt/hermes/node_modules \
    /opt/hermes/hermes_cli/web_dist /opt/hermes/ui-tui/dist
COPY --from=railway-python /opt/hermes/.venv /opt/hermes/.venv
COPY --from=railway-frontend /opt/products/tui /opt/hermes/ui-tui
COPY --from=railway-frontend /opt/products/web /opt/hermes/hermes_cli/web_dist
COPY --from=railway-frontend /opt/hermes/node_modules/typescript /opt/hermes/node_modules/typescript
RUN mkdir -p /opt/hermes/node_modules/.bin \
    && ln -s ../typescript/bin/tsc /opt/hermes/node_modules/.bin/tsc

# Same source assembly as upstream. Photon keeps its postinstall compatibility patch; npm ci
# replaces its inherited node_modules with exactly the sidecar lock's production closure.
COPY --link --chmod=a+rX,go-w . /opt/hermes/
RUN cd plugins/platforms/photon/sidecar && npm ci --no-audit --fetch-retries=5 \
    && npm cache clean --force
RUN /opt/hermes/.venv/bin/python -m docker.build_agent \
    && printf '%s\n' "${HERMES_CUSTOM_REVISION}" > /opt/hermes/.hermes_build_sha
# Tracked non-executable in git; upstream's runtime stage re-copies it executable the same way.
COPY --link --chmod=0755 docker/entrypoint-dispatch.sh /opt/hermes/docker/entrypoint-dispatch.sh
COPY --link --chmod=0755 docker/cont-init.d/00-railway-bootstrap /etc/cont-init.d/00-railway-bootstrap
# The agent builds its own project environments in /opt/data/workspace. Upstream keeps its
# pinned uv inside the PM store and resolves MCP ``uv``/``uvx`` commands there; expose those
# same binaries on PATH, as upstream does for node and npm.
RUN HERMES_HOME=/tmp/railway-build python3 -c 'from pathlib import Path; from tools.mcp_tool_config import _managed_launcher; [Path("/usr/local/bin", name).symlink_to(_managed_launcher(name)[0]) for name in ("uv", "uvx")]' \
    && rm -rf /tmp/railway-build && uv --version && uvx --version

ENV HERMES_DASHBOARD=1 \
    HERMES_DASHBOARD_HOST=0.0.0.0 \
    HERMES_DASHBOARD_PORT=9119 \
    PORT=9119 \
    S6_BEHAVIOUR_IF_STAGE2_FAILS=2
# User-installed CLIs and package caches live on the persistent writable volume.
# The inherited PATH already includes /opt/data/.local/bin.
ENV npm_config_prefix=/opt/data/.local \
    npm_config_cache=/opt/data/.npm \
    UV_CACHE_DIR=/opt/data/.cache/uv \
    UV_TOOL_DIR=/opt/data/.local/share/uv/tools \
    UV_TOOL_BIN_DIR=/opt/data/.local/bin
LABEL org.opencontainers.image.source="${HERMES_SOURCE_URL}" \
      org.opencontainers.image.revision="${HERMES_CUSTOM_REVISION}" \
      org.opencontainers.image.base.name="nousresearch/hermes-agent" \
      org.opencontainers.image.base.digest="sha256:45666f35ffa4102e1233ad6df41ccb548a0e4425063f89901117e7e84f74e54a"
EXPOSE 9119
# Upstream ENTRYPOINT is kept: s6 is PID 1; the gateway and dashboard drop to the hermes user.
CMD ["gateway", "run"]
