# syntax=docker/dockerfile:1.7
# Railway distribution image: a thin layer on the upstream image built from the upstream
# commit this branch last merged (its org.opencontainers.image.revision label). The toolchain,
# Python environment, s6 supervision and the prebuilt dashboard/TUI come from that image
# unchanged; this layer adds the distribution's source and Railway defaults. The distribution
# keeps upstream's dependency locks, so the base image's environment matches this source.
# upstream-sync.yml moves the digest and the merged upstream commit together.
ARG HERMES_BASE=nousresearch/hermes-agent@sha256:45666f35ffa4102e1233ad6df41ccb548a0e4425063f89901117e7e84f74e54a
FROM ${HERMES_BASE}
USER root
WORKDIR /opt/hermes

# Refresh security fixes for packages inherited from the pinned Debian base.
# Bump this date when reviewing a new batch of distro advisories so the layer
# is invalidated even when the upstream image digest is unchanged.
ARG DEBIAN_SECURITY_REFRESH=2026-09-29
RUN test -n "$DEBIAN_SECURITY_REFRESH" && apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

ARG RAILWAY_GIT_COMMIT_SHA
ARG HERMES_CUSTOM_REVISION=${RAILWAY_GIT_COMMIT_SHA:-unversioned-source-build}
ARG HERMES_SOURCE_URL

# Same source step as upstream's runtime stage: overlay the tree, then re-assemble the
# runtime (entry points, resource links) from it.
COPY --link --chmod=a+rX,go-w . /opt/hermes/
RUN /opt/hermes/.venv/bin/python -m docker.build_agent \
    && printf '%s\n' "${HERMES_CUSTOM_REVISION}" > /opt/hermes/.hermes_build_sha
# Tracked non-executable in git; upstream's runtime stage re-copies it executable the same way.
COPY --link --chmod=0755 docker/entrypoint-dispatch.sh /opt/hermes/docker/entrypoint-dispatch.sh
COPY --link --chmod=0755 docker/cont-init.d/00-railway-bootstrap /etc/cont-init.d/00-railway-bootstrap
# The agent builds its own project environments in /opt/data/workspace. Upstream keeps its
# pinned uv inside the PM store and resolves MCP ``uv``/``uvx`` commands there; expose those
# same binaries on PATH, as upstream does for node and npm.
RUN HERMES_HOME=/tmp/railway-build python3 -c 'from pathlib import Path; from tools.mcp_tool_config import _managed_launcher; [Path("/usr/local/bin", name).symlink_to(_managed_launcher(name)[0]) for name in ("uv", "uvx")]' \
    && rm -rf /tmp/railway-build && uv --version && uvx --version

ENV HERMES_DASHBOARD=1 \
    HERMES_DASHBOARD_HOST=0.0.0.0 \
    HERMES_DASHBOARD_PORT=9119 \
    PORT=9119 \
    S6_BEHAVIOUR_IF_STAGE2_FAILS=2
# User-installed CLIs and package caches live on the persistent writable volume.
# The inherited PATH already includes /opt/data/.local/bin.
ENV npm_config_prefix=/opt/data/.local \
    npm_config_cache=/opt/data/.npm \
    UV_CACHE_DIR=/opt/data/.cache/uv \
    UV_TOOL_DIR=/opt/data/.local/share/uv/tools \
    UV_TOOL_BIN_DIR=/opt/data/.local/bin
LABEL org.opencontainers.image.source="${HERMES_SOURCE_URL}" \
      org.opencontainers.image.revision="${HERMES_CUSTOM_REVISION}" \
      org.opencontainers.image.base.name="nousresearch/hermes-agent" \
      org.opencontainers.image.base.digest="sha256:45666f35ffa4102e1233ad6df41ccb548a0e4425063f89901117e7e84f74e54a"
EXPOSE 9119
# Upstream ENTRYPOINT is kept: s6 is PID 1; the gateway and dashboard drop to the hermes user.
CMD ["gateway", "run"]
